{
  "extends": "./.conf/tsconfig.base.json",

  "compilerOptions": {
    "rootDir": "./",
    "baseUrl": ".",
    /* ===============================
       Internal aliases (DEV ONLY)
       =============================== */
    "paths": {
      "@auxta/lib/*": ["src/lib/*"],
      "@auxta/types/*": ["src/types/*"],
      "@auxta/api/*": ["src/api/*"],
      "@auxta/classes/*": ["src/classes/*"],
      "@auxta/utils/*": ["src/utils/*"],
      "@auxta/errors/*": ["src/errors/*"],
      "@auxta/constants/*": ["src/constants/*"],
      "@auxta/core/*": ["src/core/*"],
      "@auxta/metadata/*": ["src/metadata/*"],
      "@auxta/decorators/*": ["src/decorators/*"],
      "@auxta/polyfill/crypto": ["src/polyfill/crypto.node"],
      "@auxta/polyfill/buffer": ["src/polyfill/buffer.node"],
      "@auxta/polyfill/net":    ["src/polyfill/net.node"],
      "@auxta/polyfill/fs":     ["src/polyfill/fs.node"],
      "@auxta/polyfill/process":["src/polyfill/process.node"]
    },

    /* ===============================
       Types
       =============================== */
    "types": [
      "node",
      "jest",
      "mocha",
    ],
    "typeRoots": ["node_modules/@types"]
  },

  "include": [
    "src/**/*",
    "tests/**/*",
    "examples/**/*.ts",
    "src/index.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
  ]
}